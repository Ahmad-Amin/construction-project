# Copy to .env.local and fill in from your Supabase project:
# Dashboard -> Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx (the Publishable key, never the Secret key)

# --- Optional: demo mode (see README) ---
# Server-only. Turns on the "View as contractor / homeowner" buttons and is used by `npm run seed:demo`.
DEMO_CONTRACTOR_EMAIL=demo.contractor@example.com
DEMO_CLIENT_EMAIL=demo.homeowner@example.com
DEMO_PASSWORD=choose-a-long-random-password

# Only needed to run `npm run seed:demo` (it creates the two demo logins).
# NEVER put this in a NEXT_PUBLIC_ variable and never commit it. It bypasses all row-level security.
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- Optional: shown on the Private by design page and in the footer ---
# Where people write to about their data. Set this before sharing the product.
NEXT_PUBLIC_CONTACT_EMAIL=hello@yourdomain.com
# The legal or trading name that runs the service (defaults to "BuildPeek").
NEXT_PUBLIC_OPERATOR_NAME=Your Company Name

# --- Email (notifications) ---
# Testing: Ethereal catches every email in a fake inbox, so nothing reaches a real address.
# Create a free account at https://ethereal.email/create, then paste its login here to keep ONE
# inbox across restarts. Sign in at https://ethereal.email/login to read the emails.
EMAIL_PROVIDER=ethereal
ETHEREAL_USER=
ETHEREAL_PASS=
EMAIL_FROM="BuildPeek <no-reply@buildpeek.test>"

# Later, for production, switch the provider and nothing else changes:
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxx
# EMAIL_FROM="BuildPeek <notifications@buildpeek.app>"
# Or any SMTP server:
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# --- Admin: plans, feedback (/dashboard/admin) ---
# The email addresses of the people who run the service, separated by commas. They must be confirmed
# accounts. They can open the admin pages and change companies' plans, they get a bell notification for
# every plan request and piece of feedback, and those are also emailed to them. Server-only (no
# NEXT_PUBLIC_). Empty means nobody can open the admin pages, and the emails go to NEXT_PUBLIC_CONTACT_EMAIL.
PLATFORM_ADMIN_EMAILS=

# --- Weekly summary (the Sunday email to homeowners) ---
# A long random string. The scheduled job must send it as "Authorization: Bearer <value>" to
# /api/cron/weekly-summary. Without it the job refuses to run. Generate one with: openssl rand -hex 32
CRON_SECRET=
# Optional: the public address of the site, used for links in these emails. Defaults to the
# address the job was called on.
# SITE_URL=https://buildpeek.app

# --- WhatsApp messages (Meta WhatsApp Cloud API) ---
# off  = nothing is sent and the WhatsApp switch is hidden from homeowners (default)
# log  = messages are printed in the server console instead of being sent (safe for testing)
# live = messages are sent. Needs the three values below from developers.facebook.com.
WHATSAPP_MODE=off
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
# For the one-way notice ("this number can't receive messages"): when someone writes to the
# number, the app answers once a day. Meta calls /api/whatsapp/webhook, which needs both of these.
# WHATSAPP_VERIFY_TOKEN is any long random string you choose and also enter in Meta's webhook setup;
# WHATSAPP_APP_SECRET is the Meta app's secret (App settings > Basic). Production only, Sensitive.
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# Optional. The defaults are v23.0 and en_US.
# WHATSAPP_API_VERSION=v23.0
# WHATSAPP_TEMPLATE_LANGUAGE=en_US
